<div class="container mt-5" style="max-width: 500px;">
  <%= form_with(model: family_member, local: true) do |form| %>
    <div class="form-group mb-3">
      <%= form.label :first_name %>
      <%= form.text_field :first_name, class: 'form-control' %>
    </div>

    <div class="form-group mb-3">
      <%= form.label :last_name %>
      <%= form.text_field :last_name, class: 'form-control' %>
    </div>

    <div class="form-group mb-3">
      <%= form.label :dob %>
      <%= form.date_field :dob, class: 'form-control' %>
    </div>

    <div class="form-group mb-3">
      <%= form.label :relationship_to_user %>
      <%= form.select :relationship_to_user, options_for_select(['Self', 'Son', 'Daughter', 'Spouse', 'Parent', 'Other']), {}, class: 'form-select' %>
    </div>

    <div class="d-grid mb-3">
      <%= form.submit class: 'btn btn-primary btn-block' %>
    </div>
  <% end %>
</div>

