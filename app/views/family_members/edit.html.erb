<div class="container min-vh-100 d-flex justify-content-center align-items-center">
  <div class="card p-4 shadow" style="background-color: rgba(255, 255, 255, 0.9); backdrop-filter: blur(5px); border-radius: 15px; max-width: 500px; width: 100%;">
    <h2 class="text-center mb-4">Edit Family Member</h2>

    <%= form_with(model: @family_member, local: true) do |form| %>
      <div class="form-group mb-3">
        <%= form.label :first_name %>
        <%= form.text_field :first_name, class: 'form-control' %>
      </div>

      <div class="form-group mb-3">
        <%= form.label :last_name %>
        <%= form.text_field :last_name, class: 'form-control' %>
      </div>

      <div class="form-group mb-3">
        <%= form.label :dob, 'Date of Birth' %>
        <%= form.date_field :dob, class: 'form-control' %>
      </div>

      <div class="form-group mb-4">
        <%= form.label :relationship_to_user %>
        <%= form.select :relationship_to_user, options_for_select(['Self', 'Son', 'Daughter', 'Spouse', 'Parent', 'Other'], @family_member.relationship_to_user), {}, class: 'form-select' %>
      </div>

      <div class="d-grid">
        <%= form.submit 'Update Family Member', class: 'btn btn-primary btn-lg' %>
      </div>
    <% end %>

    <div class="d-flex justify-content-between mt-4">
      <%= link_to 'Show', @family_member, class: 'btn btn-outline-primary' %>
      <%= link_to 'Back to Family Members', family_members_path, class: 'btn btn-outline-secondary' %>
    </div>
  </div>
</div>

