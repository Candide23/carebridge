<div id="<%= dom_id family_member %>">
  <p>
    <strong>First name:</strong>
    <%= family_member.first_name %>
  </p>

  <p>
    <strong>Last name:</strong>
    <%= family_member.last_name %>
  </p>

  <p>
    <strong>Dob:</strong>
    <%= family_member.dob %>
  </p>

  <p>
    <strong>Relationship to user:</strong>
    <%= family_member.relationship_to_user %>
  </p>

  <p>
    <strong>User:</strong>
    <%= family_member.user_id %>
  </p>

</div>
