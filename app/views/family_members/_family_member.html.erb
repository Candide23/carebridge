<div id="<%= dom_id family_member %>" class="col-md-6 mb-4">
  <div class="card bg-light text-dark p-3 h-100 shadow-sm">
    <h4 class="card-title"><%= family_member.first_name %> <%= family_member.last_name %></h4>
    <p><strong>Relationship:</strong> <%= family_member.relationship_to_user %></p>
    <p><strong>Date of Birth:</strong> <%= family_member.dob %></p>

    <div class="d-flex justify-content-between mt-3">
      <%= link_to 'View', family_member_path(family_member), class: 'btn btn-outline-primary btn-sm' %>
      <%= link_to 'Edit', edit_family_member_path(family_member), class: 'btn btn-outline-secondary btn-sm' %>
      <%= link_to 'Delete', family_member_path(family_member), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-outline-danger btn-sm' %>
    </div>
  </div>
</div>

