<div class="container d-flex flex-column align-items-center justify-content-center min-vh-100">
  <div class="p-5 mb-5 text-center text-dark shadow" style="background-color: rgba(255, 255, 255, 0.8); backdrop-filter: blur(5px); border-radius: 20px; max-width: 900px; width: 100%;">
    <h1 class="mb-4">Your Family Members</h1>
    <%= link_to 'Add New Family Member', new_family_member_path, class: 'btn btn-success btn-lg mb-4' %>

    <div class="row justify-content-center">
      <% @family_members.each do |family_member| %>
        <div class="col-md-6 mb-4">
          <div class="card p-3 shadow-sm h-100" style="border-radius: 15px;">
            <h4><%= family_member.first_name %> <%= family_member.last_name %></h4>
            <p><strong>Relationship:</strong> <%= family_member.relationship_to_user %></p>
            <p><strong>Date of Birth:</strong> <%= family_member.dob %></p>

            <div class="d-flex justify-content-between mt-3">
              <%= link_to 'View', family_member_path(family_member), class: 'btn btn-outline-primary btn-sm px-4' %>
              <%= link_to 'Edit', edit_family_member_path(family_member), class: 'btn btn-outline-secondary btn-sm px-4' %>
              <%= link_to 'Delete', family_member_path(family_member), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-outline-danger btn-sm px-4' %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>




