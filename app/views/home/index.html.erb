<div class="container mt-5 text-center">
  <h1 class="mb-4">Welcome to CareBridge</h1>
  <p class="lead mb-4">Track your family's health records, appointments, and reminders in a simple, multilingual app.</p>

  <% if user_signed_in? %>
    <%= link_to 'Go to Dashboard', root_path, class: 'btn btn-primary btn-lg' %>
  <% else %>
    <%= link_to 'Sign Up', new_user_registration_path, class: 'btn btn-success btn-lg me-3' %>
    <%= link_to 'Login', new_user_session_path, class: 'btn btn-outline-primary btn-lg' %>
  <% end %>
</div>

